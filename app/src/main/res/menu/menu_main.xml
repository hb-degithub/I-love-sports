<?xml version="1.0" encoding="utf-8"?>
<!-- 菜单重构：从 15 个平铺项收敛为「4 个一级动作 + 3 个分组子菜单」，减少误点 -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 一级动作：最常用 -->
    <item
        android:id="@+id/action_setup"
        android:title="开工向导"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_float"
        android:checkable="true"
        android:title="悬浮窗"
        app:showAsAction="never" />

    <!-- 分组 1：路线 -->
    <item android:title="路线">
        <menu>
            <item
                android:id="@+id/action_save_route"
                android:title="@string/menu_save_route"
                app:showAsAction="never" />
            <item
                android:id="@+id/action_route_library"
                android:title="@string/menu_route_library"
                app:showAsAction="never" />
            <item
                android:id="@+id/action_presets"
                android:title="预设路线…"
                app:showAsAction="never" />
            <item
                android:id="@+id/action_goal"
                android:title="目标配速…"
                app:showAsAction="never" />
            <item
                android:id="@+id/action_import"
                android:title="@string/menu_import"
                app:showAsAction="never" />
            <item
                android:id="@+id/action_export"
                android:title="@string/menu_export"
                app:showAsAction="never" />
        </menu>
    </item>

    <!-- 分组 2：定位与选点 -->
    <item android:title="定位与选点">
        <menu>
            <item
                android:id="@+id/action_locate"
                android:title="定位到当前位置"
                app:showAsAction="never" />
            <item
                android:id="@+id/action_add_coord"
                android:title="输入坐标添加点"
                app:showAsAction="never" />
        </menu>
    </item>

    <!-- 分组 3：诊断与外观 -->
    <item android:title="诊断与外观">
        <menu>
            <item
                android:id="@+id/action_module_status"
                android:title="模块状态与启用步骤"
