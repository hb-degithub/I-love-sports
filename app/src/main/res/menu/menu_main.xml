            <item
                android:id="@+id/action_tile_source"
                android:title="地图源"
                app:showAsAction="never" />
            <item
                android:id="@+id/action_map_diag"
                android:title="地图诊断"
                app:showAsAction="never" />
            <item
                android:id="@+id/action_root_diag"
                android:title="Root 诊断"
                app:showAsAction="never" />
        </menu>
    </item>

    <item
        android:id="@+id/action_settings"
        android:title="设置"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_about"
        android:title="关于"
        app:showAsAction="never" />
</menu>
