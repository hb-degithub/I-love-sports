<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="基础海拔（米）"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editAltitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:digits="0123456789.-"
        android:hint="50"
        android:inputType="numberDecimal"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="接管的定位 Provider"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/cbGps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="gps（GPS 定位，多数应用读取）" />

    <CheckBox
        android:id="@+id/cbNetwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="network（网络定位，兜底）" />

    <CheckBox
        android:id="@+id/cbFused"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="fused（融合定位，部分机型/GMS 无效）" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchRealism"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="拟真模式（推荐）"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="开启后：位置 1–2 m 随机游走漂移、速度/精度/朝向噪声、GNSS 卫星数与载噪比、起步 2 秒缓动。轨迹不再“完美”，更难被判定为合成定位；关闭则坐标严格贴合路径。"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchAttitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="伪造姿态传感器（指南针/AR 可能异常）"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="开启后按跑步摆动伪造旋转矢量与磁力计，使 App 用 IMU 反推的朝向与虚拟路线一致；关闭则透传真实值。"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchAutoStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="到达终点后自动停止（恢复真实定位）"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="开启后：跑到目标距离（或配速计划跑完）时，先显示「已到达」，2.5 秒后自动彻底停止并恢复手机真实定位。关闭则定位冻结在终点，需手动点「彻底停止」。"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchRandomStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="每次开始随机更换起点"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="开启后每次开始模拟会在当前路线上随机选一个起点（轨迹更自然，避免每次都从同一点出发）。"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="修改 Provider 与拟真模式在下次开始时生效"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
</LinearLayout>
