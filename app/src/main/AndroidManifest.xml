<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 定位 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 模拟位置：普通应用无法直接获得，root 下通过 appops 授予等效能力；
         若以 priv-app 形式安装则由系统授予 -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="ProtectedPermissions,MockLocation" />
    <uses-permission
        android:name="android.permission.INSTALL_LOCATION_PROVIDER"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 虚拟摄像头悬浮窗的前台服务（Android 14 起特殊用途需单独声明） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 采集周围基站 / Wi-Fi 指纹（环境快照） -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- 前台悬浮窗（需用户在系统设置中手动允许"显示在其他应用上层"） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- Android 11+ 包可见性：作用域页要列出桌面可启动应用，必须声明这条 <queries>，
         否则 queryIntentActivities 只会返回本应用自己。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- 备份加固：备份/迁移会带出路线库、使用记录、作用域名单、快照名等落盘痕迹。
         allowBackup=false 关掉自动备份；fullBackupContent="false" 是 API<31 的另写法
         （部分 ROM / 旧框架只看这一条）；dataExtractionRules 是 API 31+ 的正式规则，
         两份规则文件里一个 include 都没有，等价于"任何数据都不备份、不迁移"。 -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VirtualMotion">

        <!-- 内置 LSPosed 隐藏模块（单 APK 同时是主 App 与模块） -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="虚拟运动内置隐藏模块：Location/Settings/AppOps/ContentProvider/Parcel + 基站/Wi-Fi 环境回放" />
        <!-- xposedminversion 必须 ≥93 才会启用 LSPosed 的 New XSharedPreferences：
             API 93 起 LSPosed 会 hook ContextImpl.getPreferencesDir()/checkMode(int)，
             MODE_WORLD_READABLE 的 prefs 才写得出、模块才读得到（快照通道的第三条路）。 -->
        <meta-data
            android:name="xposedminversion"
            android:value="54" />
        <!-- 显式声明本模块使用 world-readable SharedPreferences（与 xposedminversion≥93 等价，
             两者都写上，避免个别 LSPosed 版本只看这一条） -->
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />


        <activity
            android:name=".ui.SetupActivity"
            android:exported="false"
            android:label="@string/setup_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- 作用域（目标应用）选择：仅内部页面，不对外暴露 -->
        <activity
            android:name=".ui.ScopeActivity"
            android:exported="false"
            android:label="@string/scope_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- 使用记录（会话历史）：仅内部页面，不对外暴露 -->
        <activity
            android:name=".ui.UsageLogActivity"
            android:exported="false"
            android:label="使用记录" />

        <!-- 环境快照：仅模拟期间暴露给 LSPosed 模块（无需权限，无数据时返回 0 行） -->
        <!-- libxposed service 通道：LSPosed 通过 content://com.vloc.motion.XposedService
             送 binder，应用侧才能拿到 remote preferences（新 API 后端下唯一的快照通道）。
             缺这个 Provider 时 registerListener 永不回调、远程偏好恒不可用。 -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="com.vloc.motion.XposedService"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
        <provider
            android:name=".service.EnvProvider"
            android:authorities="com.vloc.motion.env"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
